# encoding: utf-8
# 2024 R2
SetScriptVersion(Version="24.2.133")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath="D:/3D Model/210180104009_Bhaskar-Bhatt/Solidworks/wrench.SLDPRT")
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
modelComponent1.Update(AllDependencies=True)
geometryComponent1 = system1.GetComponent(Name="Geometry")
geometryComponent1.Update(AllDependencies=True)
system1.Update(AllDependencies=True)
system1.Delete()
fileType1 = GetFileType(Name="GeometryFileType")
ImportFile(
    FilePath="D:/3D Model/210180104009_Bhaskar-Bhatt/Solidworks/wrench.SLDPRT",
    FileType=fileType1)
system2 = GetSystem(Name="Geometry")
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.Edit(IsDiscoveryGeometry=True)
system3 = template1.CreateSystem()
model1 = system3.GetContainer(ComponentName="Model")
model1.Edit()
geometry2.Exit()
modelComponent2 = system3.GetComponent(Name="Model")
modelComponent2.Refresh()
modelComponent2.Refresh()
geometry3 = system3.GetContainer(ComponentName="Geometry")
geometry3.Edit(IsDiscoveryGeometry=True)
system3.Delete()
system2.Delete()
system4 = template1.CreateSystem()
geometry4 = system4.GetContainer(ComponentName="Geometry")
geometry4.SetFile(FilePath="D:/3D Model/wrench.dsco")
modelComponent3 = system4.GetComponent(Name="Model")
modelComponent3.Refresh()
model2 = system4.GetContainer(ComponentName="Model")
model2.Edit()
unitSystem1 = SetProjectUnitSystem(UnitSystemName="NMMTON_STANDARD")
unitSystem2 = SetProjectUnitSystem(UnitSystemName="NMMTON_STANDARD")
model2.Exit()
model2.Edit()
Save(Overwrite=True)
